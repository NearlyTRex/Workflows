#!/bin/bash
# Idioms for the shell coverage plugin's tests, odd on purpose, so not linted.
# shellcheck disable=all
# header comment (with parens) and "quotes' of both kinds
set -euo pipefail

# --- functions in each spelling ---------------------------------------
plain() {
    echo "plain"
}

keyword_style() {
    echo "keyword"
}

brace_on_next_line()
{
    echo "next-line brace"
}

function with_keyword {
    echo "with keyword"
}

function with_keyword_and_parens() {
    echo "both"
}

one_liner() { echo "one-liner"; }

plain; keyword_style; brace_on_next_line; with_keyword; with_keyword_and_parens; one_liner

# --- case in every shape ----------------------------------------------
classify() {
    case "$1" in
        # comment before a pattern (with parens)
        a|b)
            echo "alt"
            ;;
        (c)
            echo "leading paren"
            ;;
        d) echo "one-line" ;;
        e)
            # comment inside an arm) with a stray paren
            echo "commented arm"
            ;&
        f)
            echo "fallthrough"
            ;;&
        *)
            echo "default"
            ;;
    esac
}
for v in a c d e z; do classify "$v" > /dev/null; done

nested() {
    case "$1" in
        x)
            case "$2" in
                y) echo "nested" ;;
                *) echo "inner default" ;;
            esac
            ;;
    esac
}
nested x y
nested x q

# --- conditionals ------------------------------------------------------
branch() {
    if [[ "$1" == "a" ]]; then
        echo "if"
    elif [[ "$1" == "b" ]]; then
        echo "elif"
    else
        echo "else"
    fi
}
branch a; branch b; branch c

[[ -n "x" ]] && echo "and-list" || echo "or-list"
[[ -z "x" ]] || echo "or"
if [[ "abc" =~ ^a(b)c$ ]]; then echo "regex ${BASH_REMATCH[1]}"; fi

# --- loops ---------------------------------------------------------------
for i in 1 2; do
    echo "for $i"
done

for ((n = 0; n < 2; n++)); do
    echo "arith for $n"
done

count=0
while [[ $count -lt 2 ]]; do
    count=$((count + 1))
done

until [[ $count -le 0 ]]; do
    count=$((count - 1))
done

while IFS= read -r line; do
    echo "here-string $line"
done <<< "one"

while IFS= read -r line; do
    echo "process-sub $line"
done < <(printf '%s\n' "a (b" "c)")

while read -r line; do
    echo "heredoc loop $line"
done <<EOF
looped
EOF

printf '%s\n' x y | while read -r line; do
    echo "piped $line"
done

# --- heredocs -------------------------------------------------------------
cat <<EOF > /dev/null
unquoted $HOME
if fi done esac
EOF

cat <<'EOF' > /dev/null
quoted $HOME
EOF

cat <<-EOF > /dev/null
	tab indented
	EOF

heredoc_in_function() {
    cat <<EOF > /dev/null
inside a function
EOF
}
heredoc_in_function

x=$(cat <<EOF
captured
EOF
)
echo "$x"

# --- multi-line commands ---------------------------------------------------
echo "continued" \
    "across" \
    "lines"

true &&
    echo "and-continued"

printf '%s\n' a b |
    sort |
    head -n 1

args=(
    one
    two
)
echo "${args[@]}"

declare -A map=(
    [k]="v"
)
echo "${map[k]}"

y=$(
    echo "multi-line substitution"
)
echo "$y"

z="a
b"
echo "$z"

echo "string with ; and # and ) and done and fi"
echo 'single with " and # and ('
echo "hash # inside"

# --- awk / sed programs spanning lines ------------------------------------
printf 'a b\n' | awk '
    # awk comment with ) and "
    { print $1 }
    END { print "done" }
' > /dev/null

printf 'a\n' | sed -e 's/a/b/' \
    -e 's/b/c/' > /dev/null

# --- groups, subshells, traps ------------------------------------------------
{
    echo "brace group"
    echo "second"
}

(
    echo "subshell"
    cd /
)

( echo "inline subshell" )

cleanup() {
    echo "cleanup"
}
trap 'cleanup' EXIT

trap '
    echo "multi-line trap"
' USR1
kill -USR1 $$

# --- arithmetic, expansions, misc ------------------------------------------
echo $((1 + 2)) $((1<<3))
echo "${HOME:-unset} ${undefined:-default} ${#HOME}"
local_demo() {
    local a=1 b=2
    echo "$a$b"
}
local_demo
exec 3>&1
echo "to fd3" >&3
exec 3>&-
: "colon command"
export EXPORTED=1
readonly CONST=1
unset EXPORTED
shopt -s nullglob
set +e
false
set -e
echo "end"
