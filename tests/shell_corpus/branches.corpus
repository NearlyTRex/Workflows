#!/bin/bash
# Idioms for the shell coverage plugin's tests, odd on purpose, so not linted.
# shellcheck disable=all
# The right-hand side of every && and || below runs at least once, and each left
# side is exercised both ways, so branch coverage reaches 100%. The last part holds
# operators that are NOT list operators and must not be counted at all.
set -u

one_line() {
    [[ "$1" == "yes" ]] && echo "and: yes" || printf '%s\n' "or: no"
}
one_line yes
one_line no

continued() {
    [[ "$1" == "yes" ]] \
        || echo "continuation handler"
}
continued yes
continued no

trailing_operator() {
    [[ "$1" == "yes" ]] &&
        echo "trailing operator"
}
trailing_operator yes
trailing_operator no

group_on_one_line() {
    [[ "$1" == "yes" ]] || { echo "group handler"; return 0; }
}
group_on_one_line yes
group_on_one_line no

group_on_next_lines() {
    [[ "$1" == "yes" ]] || {
        echo "multi-line group handler"
    }
}
group_on_next_lines yes
group_on_next_lines no

in_condition() {
    if [[ "$1" == "yes" ]] || [ "$1" = "maybe" ]; then
        echo "condition"
    fi
}
in_condition yes
in_condition maybe
in_condition no

assignment_handler() {
    false || status=$?
    echo "$status"
}
assignment_handler

single_bracket() {
    [ "$1" = "yes" ] && echo "single bracket"
}
single_bracket yes
single_bracket no

negated() {
    ! false && echo "negated"
}
negated

arithmetic() {
    (( $1 > 0 )) && echo "arithmetic"
}
arithmetic 1
arithmetic 0

case_arm() {
    case "$1" in
        a) [[ "$2" == "x" ]] && echo "case arm" ;;
    esac
}
case_arm a x
case_arm a y

same_word_twice() {
    # both sides are `echo`, so a trace of the line can't tell them apart
    [[ "$1" == "yes" ]] && echo "first" || echo "second"
}
same_word_twice yes

variable_command() {
    local cmd=true
    $cmd && echo "variable command word"
}
variable_command

# --- not list operators: nothing below is a branch -------------------------
true   # a comment about && and ||
[[ "a" == "a" && "b" == "b" ]]
(( 1 && 1 ))
echo "a && b" 'c || d' > /dev/null
nested=$(true && echo substitution)
echo "$nested"
cat <<EOF > /dev/null
a && b || c
EOF
echo "end"
