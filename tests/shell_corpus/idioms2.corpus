#!/bin/bash
# Idioms for the shell coverage plugin's tests, odd on purpose, so not linted.
# shellcheck disable=all
set -euo pipefail

count=0
(( count++ )) || true
((count += 1))

# loops and groups followed by pipes / redirects
for i in 1 2; do
    echo "$i"
done | cat > /dev/null

{
    echo "group"
} | cat > /dev/null

{
    echo "group to file"
} > /dev/null

if true; then
    echo "if piped"
fi | cat > /dev/null

# substitutions containing control flow
r=$(
    if true; then
        echo "if in substitution"
    fi
)
echo "$r"

c=$(
    case x in
        x) echo "case in substitution" ;;
    esac
)
echo "$c"

d=$(
    # comment inside a substitution (with parens)
    echo "after comment"
)
echo "$d"

b=`echo backticks`
echo "$b"

# heredoc in a case arm
case a in
    a)
        cat <<EOF > /dev/null
in an arm
EOF
        ;;
esac

# keywords on their own lines
while true
do
    break
done

if true
then
    echo "then on next line"
fi

for x in a b; do echo "$x"; done > /dev/null
case x in x) echo "one-line case" ;; esac

if true; then if true; then echo "nested ifs"; fi; fi

f() { echo "inline"
    echo "two-line body"; }
f

# trailing comments on closers
if true; then
    echo "closers"
fi # done with the if

case x in
    x) echo "x" ;;
esac # done with the case

# quoting corner cases
echo $'ansi-c with \n newline'
echo $'it\'s ( an escaped quote'
echo "${HOME//\//-}"
echo "paren in expansion: ${HOME#*(}" > /dev/null
[[ "a(b" == *\(* ]] && echo "escaped paren"
echo "$(( (1 + 2) * 3 ))"
echo 'it'"'"'s'
echo "backslash \\ and quote \" and paren )"

# declarations spanning lines
local_vars() {
    local first=1 \
        second=2
    echo "$first$second"
}
local_vars

readonly LONG="a \
b"
echo "$LONG"

[[ "a" == "a" &&
    "b" == "b" ]] && echo "multi-line test"

if [[ "a" == "a" ||
    "b" == "c" ]]; then
    echo "multi-line condition"
fi

# here-strings with literal words, ANSI-C quotes, parens inside an expansion
cat <<< "literal" > /dev/null
cat <<<bare > /dev/null
echo $'it\'s ( an escaped quote' > /dev/null
echo ${HOME#*(} > /dev/null

# multi-line process substitution after a closer (inside a function, bash traces
# its commands on the function's header line)
multi_line_loop() {
    while IFS= read -r item; do
        echo "item $item"
    done < <(printf '%s\n' a b \
        | sort || true)
}
multi_line_loop

# keywords alone on a line, the condition on the lines after (Gradle's gradlew style)
while
    [[ $count -gt 0 ]]
do
    count=$((count - 1))
done

if
    [[ "$count" == "0" ]]
then
    echo "bare if"
fi

# a # inside quotes is text, not a comment
echo "value # not a comment" > /dev/null
echo 'also # not a comment' > /dev/null
echo $'ansi-c # not a comment' > /dev/null
quoted="# literal"
echo "$quoted" "x" # a real comment
while IFS= read -r item; do
    echo "hash item $item"
done < <(printf '%s\n' "a # b" '# c')
echo "after the loop"

echo "end"
